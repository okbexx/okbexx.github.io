---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('blog');
const sorted = entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<BaseLayout title="构建记录">
  <section style="padding: 40px 0;">
    <h1 style="font-size: 36px; font-weight: 900; margin-bottom: 12px;">构建记录</h1>
    <p style="color: var(--text-secondary); font-size: 16px; margin-bottom: 40px; line-height: 1.8; max-width: 700px;">
      系统演进 · 产品尝试 · AI 协作中的真实判断。这些记录持续归档这套一人系统的演进过程。
    </p>
    <ul class="record-list">
      {sorted.map((entry) => (
        <li>
          <a href={`/blog/${entry.id}`} class="record-card">
            <div class="record-card-title">{entry.data.title}</div>
            <div class="record-card-desc">{entry.data.description}</div>
            <div class="record-card-meta">
              <span>{entry.data.date}</span>
              {entry.data.tags?.map((tag: string) => (
                <span class="record-card-tag">{tag}</span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
