---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('blog');
const posts = entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const coreSystems = [
  {
    icon: '🧪',
    label: '内部知识系统',
    title: 'Distill · 知识蒸馏塔',
    href: '/distill',
    description: '把来源、项目、概念、决策、约束和输出接成可维护的知识运行层。AI 负责整理，人负责判断。',
    points: ['对象有清晰类型与生命周期', '流程强度按风险分层', '输出会持续回流成可维护资产'],
  },
  {
    icon: '🥊',
    label: '外部样本层',
    title: 'Technical Knockout · 架构与实现参考库',
    href: '/technical-knockout',
    description: '把优秀开源项目拆成可复用的架构模式、实现路径和 trade-off，作为下一次构建的外部参考坐标。',
    points: ['持续拆解优秀开源项目并抽取可复用模式', '五层拆解定位、架构、质量、社区与决策', '为下一次构建提供更快、更稳、更有方向的参考'],
  },
  {
    icon: '🤖',
    label: '执行系统',
    title: 'Agent Workflow · 一人执行系统',
    href: '/blog',
    description: '把探索、编码、验证和知识沉淀接成可重复的执行闭环，让这套系统真正持续产出。',
    points: ['多 agent 协同推进复杂任务', '研究、实现、验证、沉淀形成闭环', '把系统能力转成产品、文章与可复用流程'],
  },
];

const outputs = [
  {
    label: '代表作 / 产品',
    title: 'distill-vault · Distill Runtime',
    href: '/distill-vault',
    description: '把蒸馏塔变成真正可运行的知识底盘：图数据库、混合搜索、社区发现、MCP，以及面向 Hermes / Codex / Claude 的平台差异化 Skill 分发。',
    chips: ['97/97 tests', '3 platform renderers'],
  },
  {
    label: '能力扩展实验',
    title: 'Build Your Own X · 用 AI 协作重学计算机系统',
    href: '/super-individual/relearn-computer-systems',
    description: '把复杂系统拆成持续学习与可交付输出，借助 AI 协作，把复杂能力一点点变成可理解、可复用、可交付的资产。',
    chips: ['每日学习实验', 'README + 学习卡'],
  },
  {
    label: '过程公开层',
    title: '公开构建 · 过程与判断归档',
    href: '/blog',
    description: '持续归档系统演进、产品尝试与关键判断，为后续构建保留可回看的过程上下文。',
    chips: [`${posts.length} 篇记录`, '持续更新'],
  },
];

const principles = [
  {
    title: '系统先于单点效率',
    text: '每次构建都要回流成规则、知识或可复用资产，否则速度只是一时加速。',
  },
  {
    title: '人负责方向，AI 负责放大',
    text: 'AI 处理整理、生成、并行推进与验证，人承担目标、边界、取舍和最终责任。',
  },
  {
    title: '研究直接服务实现',
    text: '无论拆解开源项目还是整理知识，最终都要为下一次产品构建提供更快、更稳的起点。',
  },
];
---
<BaseLayout
  title="公开构建中的一人系统"
  description="Jarl 正在把知识、工具和 AI 接成一套一个人的工作系统：Distill、Technical Knockout 与多 Agent 工作流共同驱动真实产出。"
>
  <section class="hero-section">
    <div class="eyebrow">公开构建中的一人系统</div>
    <h1>把知识、工具和 AI 接成一套一个人的工作系统</h1>
    <p class="hero-copy">
      这里公开展示一套正在运行的一人系统：Distill 负责知识蒸馏，Technical Knockout 负责架构参考，Agent Workflow 负责把判断变成实现、验证和沉淀。它持续产出产品原型、方法沉淀和可回看的构建记录。
    </p>
    <div class="hero-actions">
      <a class="primary-button" href="#systems">看我在构建什么</a>
      <a class="secondary-button" href="#build-log">查看最新构建记录</a>
    </div>
    <div class="hero-signal-grid">
      <div class="signal-card">
        <span>内部知识</span>
        <strong>Distill</strong>
        <p>把输入蒸馏成可复用知识资产</p>
      </div>
      <div class="signal-card">
        <span>外部样本</span>
        <strong>Technical Knockout</strong>
        <p>给 coding agent 提供架构参考坐标</p>
      </div>
      <div class="signal-card">
        <span>执行系统</span>
        <strong>Agent Workflow</strong>
        <p>把研究、实现、验证和沉淀接成闭环</p>
      </div>
    </div>
  </section>

  <section id="systems" class="content-section">
    <div class="section-heading">
      <div class="section-label">CORE SYSTEMS</div>
      <h2>我在构建什么</h2>
      <p>
        Distill 管内部知识，Technical Knockout 管外部样本，Agent Workflow 负责执行与闭环。三者一起把研究、判断和实现接成长期运行的工作系统。
      </p>
    </div>
    <div class="feature-grid three-up">
      {coreSystems.map((system) => (
        <a
          href={system.href}
          target={system.external ? '_blank' : undefined}
          rel={system.external ? 'noreferrer' : undefined}
          class="feature-card"
        >
          <div class="feature-topline">{system.icon} {system.label}</div>
          <h3>{system.title}</h3>
          <p>{system.description}</p>
          <ul>
            {system.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <section class="content-section">
    <div class="section-heading">
      <div class="section-label">RUNNING OUTPUTS</div>
      <h2>这些系统，已经跑出了什么</h2>
      <p>
        下面这些作品，是这套系统当前最清晰的外部证据。
      </p>
    </div>
    <div class="feature-grid outputs-grid">
      {outputs.map((item) => (
        <a href={item.href} class="output-card">
          <div class="feature-topline">{item.label}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <div class="chip-row">
            {item.chips.map((chip) => (
              <span class="chip">{chip}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="content-section split-section">
    <div>
      <div class="section-label">WORKING PRINCIPLES</div>
      <h2>我怎么工作</h2>
      <div class="principle-list">
        {principles.map((item) => (
          <div class="principle-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="about-card-shell">
      <div class="section-label">ABOUT</div>
      <div class="about-card">
        <h3>关于 Jarl</h3>
        <p>
          工程师。正在把知识蒸馏、架构研究和多 Agent 执行接成一套长期运行的一人系统，并把过程、作品与判断持续公开。
        </p>
        <a href="/about">更多背景 →</a>
      </div>
    </div>
  </section>

  <section id="build-log" class="content-section build-log-section">
    <div class="section-heading">
      <div class="section-label">BUILD LOG</div>
      <h2>最新构建记录</h2>
      <p>
        系统演进、产品尝试、架构判断与 AI 协作实践，都在这里持续归档。
      </p>
    </div>
    <ul class="record-list build-log-list">
      {posts.slice(0, 3).map((entry) => (
        <li>
          <a href={`/blog/${entry.id}`} class="record-card build-log-item">
            <div class="record-card-title">{entry.data.title}</div>
            <div class="record-card-desc">{entry.data.description}</div>
            <div class="record-card-meta">
              <span>{entry.data.date}</span>
              {entry.data.tags?.map((tag: string) => (
                <span class="record-card-tag">{tag}</span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/blog" class="inline-link">查看全部构建记录 →</a>
  </section>

  <style>
    .hero-section {
      padding: 72px 0 52px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .eyebrow,
    .section-label,
    .feature-topline {
      width: fit-content;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(56, 189, 248, 0.22);
      background: rgba(56, 189, 248, 0.08);
      color: var(--blue);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .hero-section h1 {
      max-width: 820px;
      font-size: 54px;
      line-height: 1.08;
      letter-spacing: -1.8px;
    }

    .hero-copy,
    .section-heading p,
    .about-card p,
    .principle-card p,
    .feature-card p,
    .output-card p {
      color: var(--text-secondary);
      font-size: 17px;
      line-height: 1.85;
    }

    .hero-copy {
      max-width: 720px;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .primary-button,
    .secondary-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 20px;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 700;
      transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }

    .primary-button {
      background: linear-gradient(135deg, #38BDF8, #7DD3FC);
      border: 1px solid rgba(56, 189, 248, 0.45);
      color: #0D1117;
      box-shadow: 0 18px 40px rgba(56, 189, 248, 0.24);
    }

    .secondary-button,
    .about-card,
    .signal-card,
    .principle-card,
    .feature-card,
    .output-card {
      background: linear-gradient(180deg, rgba(22, 27, 34, 0.98), rgba(13, 17, 23, 0.96));
      border: 1px solid var(--border);
      color: var(--text);
    }

    .secondary-button {
      color: var(--text-secondary);
    }

    .primary-button:hover,
    .secondary-button:hover,
    .feature-card:hover,
    .output-card:hover,
    .build-log-item:hover {
      transform: translateY(-2px);
    }

    .hero-signal-grid,
    .feature-grid {
      display: grid;
      gap: 18px;
    }

    .hero-signal-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 8px;
    }

    .signal-card {
      border-radius: 18px;
      padding: 22px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
    }

    .signal-card span {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 10px;
    }

    .signal-card strong {
      display: block;
      font-size: 22px;
      line-height: 1.25;
      margin-bottom: 8px;
    }

    .signal-card p {
      font-size: 14px;
      line-height: 1.7;
      color: var(--text-secondary);
    }

    .content-section {
      padding: 44px 0;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .section-heading {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 760px;
    }

    .section-heading h2,
    .split-section h2 {
      font-size: 36px;
      line-height: 1.15;
      letter-spacing: -1px;
    }

    .three-up {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .outputs-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .feature-card,
    .output-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      border-radius: 20px;
      padding: 26px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
      text-decoration: none;
    }

    .feature-card h3,
    .output-card h3,
    .principle-card h3,
    .about-card h3 {
      font-size: 22px;
      line-height: 1.35;
      color: var(--text);
    }

    .feature-card ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: auto;
    }

    .feature-card li {
      position: relative;
      padding-left: 18px;
      color: var(--text-secondary);
      font-size: 14px;
      line-height: 1.7;
    }

    .feature-card li::before {
      content: '·';
      position: absolute;
      left: 0;
      color: var(--purple);
      font-size: 22px;
      line-height: 1;
      top: -2px;
    }

    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: auto;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 0 12px;
      border-radius: 999px;
      border: 1px solid rgba(56, 189, 248, 0.18);
      background: rgba(56, 189, 248, 0.08);
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
    }

    .split-section {
      display: grid;
      grid-template-columns: 1.4fr 0.9fr;
      gap: 24px;
      align-items: start;
    }

    .principle-list {
      display: grid;
      gap: 16px;
      margin-top: 20px;
    }

    .principle-card,
    .about-card {
      border-radius: 18px;
      padding: 24px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.14);
    }

    .about-card-shell {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .about-card a,
    .inline-link {
      color: var(--blue);
      font-size: 15px;
      font-weight: 600;
    }

    .build-log-section {
      padding-bottom: 20px;
    }

    .build-log-list {
      background: linear-gradient(180deg, rgba(22, 27, 34, 0.94), rgba(13, 17, 23, 0.92));
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 0 26px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
    }

    .build-log-item {
      padding: 30px 0;
    }

    @media (max-width: 900px) {
      .hero-section h1 {
        font-size: 44px;
      }

      .hero-signal-grid,
      .three-up,
      .outputs-grid,
      .split-section {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .hero-section {
        padding-top: 48px;
      }

      .hero-section h1 {
        font-size: 36px;
        letter-spacing: -1px;
      }

      .section-heading h2,
      .split-section h2 {
        font-size: 30px;
      }

      .feature-card,
      .output-card,
      .signal-card,
      .principle-card,
      .about-card {
        padding: 22px;
      }

      .build-log-list {
        padding: 0 18px;
      }
    }
  </style>
</BaseLayout>
